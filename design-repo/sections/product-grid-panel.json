{
  "$schema": "dtai-design-tokens/section",
  "id": "product-grid-panel",
  "typeId": "product-grid-panel",
  "registryId": "section.product-grid-panel",
  "version": "1.0.0",
  "category": "cross-sell",
  "purpose": "Homepage 'PRODUCTS' section \u2014 the full grid of all products, heavier/more visual than related-products-grid on product pages.",
  "industryTags": [
    "fintech",
    "banking-infrastructure",
    "b2b-saas"
  ],
  "styleTags": [
    "flagship",
    "dense"
  ],
  "measuredFrom": [
    "/ (Container, 1249px)"
  ],
  "contentModel": {
    "required": [
      "eyebrow",
      "heading (role=heading.xl, maxWords 10)",
      "products[10..17]: {icon, title, description, href}"
    ]
  },
  "layout": {
    "desktop_1440x900": {
      "height": "1249px"
    },
    "tablet_810x1080": {
      "height": "~1600px"
    },
    "mobile_390x844": {
      "height": "~3500px stacked"
    }
  },
  "motion": {
    "driven": true,
    "roles": [
      "entrance.slideUp, staggered"
    ],
    "reducedMotionFallback": "static grid"
  },
  "compatibility": {
    "onlyOn": [
      "homepage"
    ],
    "maxInstancesPerPage": 1
  },
  "generation": {
    "componentRefs": [
      "components/product-card.json"
    ],
    "tokenRefs": []
  },
  "accessibility": {
    "headingLevel": "h2"
  },
  "constraints": {
    "maxWords": {
      "title": 3,
      "description": 20
    }
  }
}
