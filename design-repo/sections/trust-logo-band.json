{
  "$schema": "dtai-design-tokens/section",
  "id": "trust-logo-band",
  "typeId": "trust-logo-band",
  "registryId": "section.trust-logo-band",
  "version": "1.0.0",
  "category": "social-proof",
  "purpose": "Homepage-only 'TRUSTED AT SCALE' band with a headline stat and customer logos.",
  "industryTags": [
    "fintech",
    "banking-infrastructure",
    "b2b-saas"
  ],
  "styleTags": [
    "flagship"
  ],
