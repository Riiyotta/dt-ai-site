{
  "$schema": "dtai-design-tokens/section",
  "id": "logo-credentials-band",
  "typeId": "logo-credentials-band",
  "registryId": "section.logo-credentials-band",
  "version": "1.0.0",
  "category": "social-proof",
  "purpose": "Row of partner/regulator logos or short credential statements ('Nationally Chartered US Bank', 'Regulated by the OCC').",
  "industryTags": [
    "fintech",
    "banking-infrastructure",
    "b2b-saas"
  ],
  "styleTags": [
    "minimal",
    "trust-forward"
  ],
  "measuredFrom": [
    "/correspondent-banking/ (_credentials__Section, 156px)",
    "/property-management/ (_logos__Section, 163px; _partners__Section, 140px)"
  ],
  "contentModel": {
    "required": [
      "items[3..6]: {logoOrLabel, sublabel (optional, maxWords 6)}"
    ]
  },
  "layout": {
    "desktop_1440x900": {
      "height": "140-163px, single row"
    },
    "tablet_810x1080": {
      "height": "~200px, wraps 2 rows"
    },
    "mobile_390x844": {
      "height": "~400px, stacked"
    }
  },
  "motion": {
    "driven": false
  },
  "compatibility": {
    "repeatable": true,
    "min": 0,
    "max": 2,
    "compatibleWith": [
      "stats-band",
      "workflow-feature-panel"
    ]
  },
  "generation": {
    "componentRefs": [
      "components/logo-band.json"
    ],
    "tokenRefs": []
  },
  "accessibility": {
    "headingLevel": null
  },
  "constraints": {
    "maxWords": {
      "sublabel": 6
    }
  }
}
